API_KEY=change-me                 # bootstrap admin key; people get their own via `python -m app.users add NAME`
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/extractor
REDIS_URL=redis://redis:6379/0

FETCH_BACKEND=jina                # jina | httpx
JINA_API_KEY=
JINA_RPM=500                      # TUNE to the Jina plan's real limit
JINA_TIMEOUT_S=10                 # Jina's own X-Timeout; our client waits 5s LONGER
RATE_LIMIT_BACKEND=redis          # redis = one JINA_RPM shared by the API and every worker

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_CONCURRENCY=10
TYPESAFE_CONFIDENCE_MIN=0.8       # TUNE
TYPESAFE_BELONGS_MIN=0.5          # TUNE

GLOBAL_FETCH_CONCURRENCY=50       # TUNE
PER_DOMAIN_CONCURRENCY=2
MAX_PAGES_PER_DOMAIN=5            # homepage + 4
MAX_PAGE_BYTES=2000000
MAX_PAGE_TOKENS=50000
EARLY_STOP_ON_FIRST_GOOD=false   # true = stop at the first good address
COLLECT_ALL_EMAILS=true
CACHE_DAYS=90
CONNECT_TIMEOUT_S=3
READ_TIMEOUT_S=7                  # direct target fetches only, not the Jina call
FETCH_GUARD_PRIVATE_ADDRESSES=true # refuse sites that resolve or redirect into the private network
DOMAIN_TIMEOUT_S=180              # hard cap per domain; > 2x the worst-case page ladder
MAX_DOMAIN_ATTEMPTS=3             # whole-domain retries when the breaker is open
RETRY_PASS_DELAY_S=600            # wait before re-running transient failures
USER_AGENT=Mozilla/5.0 (compatible; ContactFinder/1.0)

# Multi-user
MAX_ACTIVE_JOBS_PER_USER=3
RATE_LIMIT_PER_MINUTE=120         # per person; job status polling is exempt
MAX_UPLOAD_BYTES=52428800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
WEBHOOK_TIMEOUT_S=10
WEBHOOK_SECRET=                   # set to HMAC-sign webhook deliveries
ALLOW_HTTP_WEBHOOKS=false

# Deployment
BIND_ADDR=127.0.0.1               # thor: its Tailscale IP
TUNNEL_TOKEN=                     # Cloudflare Tunnel for the portal; see docker-compose.yml

# Debug / ops (not in the spec's .env block, defaults are safe)
DEBUG_STORE_HTML=false
HTML_STORE_DIR=/data/html
LOG_LEVEL=INFO

# Provider keys set from the portal are encrypted with this. base64 of 32 random bytes:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# The API and the worker MUST have the same value; a process that cannot decrypt a
# saved key uses no key at all (and the portal's key panel shows it as unreadable).
PROVIDER_KEY_ENCRYPTION_KEY=
JINA_RESUME_MIN_TOKENS=10000000
